{
  "$comment": "Platform-neutral UI scenarios. Web runs them with Playwright (apps/web/e2e/scenarios.spec.ts); mobile runs the Maestro flows generated into spec/scenarios/maestro/ by `pnpm spec:generate`. Selectors come from spec/test-ids.json. Step vocabulary is documented in spec/README.md.",
  "scenarios": [
    {
      "name": "add-todo",
      "steps": [
        { "expect": "empty" },
        { "do": "add", "title": "Buy milk", "priority": "high" },
        { "expect": "titles", "titles": ["Buy milk"] },
        { "expect": "remaining", "text": "1 task remaining" }
      ]
    },
    {
      "name": "complete-and-reopen",
      "steps": [
        { "do": "add", "title": "Walk the dog" },
        { "do": "toggle", "title": "Walk the dog" },
        { "expect": "completed", "title": "Walk the dog", "value": true },
        { "expect": "remaining", "text": "0 tasks remaining" },
        { "expect": "undo", "label": "Completed todo" },
        { "do": "toggle", "title": "Walk the dog" },
        { "expect": "completed", "title": "Walk the dog", "value": false },
        { "expect": "remaining", "text": "1 task remaining" }
      ]
    },
    {
      "name": "delete-and-undo",
      "steps": [
        { "do": "add", "title": "Buy milk" },
        { "do": "add", "title": "Call mom" },
        { "do": "delete", "title": "Buy milk" },
        { "expect": "titles", "titles": ["Call mom"] },
        { "expect": "undo", "label": "Deleted todo" },
        { "do": "undo" },
        { "expect": "titles", "titles": ["Buy milk", "Call mom"] },
        { "expect": "undo", "label": null }
      ]
    },
    {
      "name": "rename-persists",
      "steps": [
        { "do": "add", "title": "Buy milk" },
        { "do": "rename", "from": "Buy milk", "to": "Buy oat milk" },
        { "expect": "titles", "titles": ["Buy oat milk"] },
        { "do": "relaunch" },
        { "expect": "titles", "titles": ["Buy oat milk"] }
      ]
    },
    {
      "name": "sort-by-priority",
      "steps": [
        { "do": "add", "title": "Low one", "priority": "low" },
        { "do": "add", "title": "Medium one" },
        { "do": "add", "title": "High one", "priority": "high" },
        { "expect": "titles", "titles": ["High one", "Medium one", "Low one"] }
      ]
    },
    {
      "name": "filter-and-clear-completed",
      "steps": [
        { "do": "add", "title": "Buy milk" },
        { "do": "add", "title": "Call mom" },
        { "do": "toggle", "title": "Buy milk" },
        { "do": "filter", "filter": "active" },
        { "expect": "titles", "titles": ["Call mom"] },
        { "do": "filter", "filter": "completed" },
        { "expect": "titles", "titles": ["Buy milk"] },
        { "do": "filter", "filter": "all" },
        { "do": "clearCompleted" },
        { "expect": "titles", "titles": ["Call mom"] },
        { "expect": "undo", "label": "Deleted todo" },
        { "do": "undo" },
        { "expect": "titles", "titles": ["Call mom", "Buy milk"] }
      ]
    },
    {
      "name": "quick-add-shorthand",
      "steps": [
        { "do": "type", "text": "Call mom 2030-01-15 #family !p1" },
        { "expect": "quickAddPreview", "title": "Call mom" },
        { "do": "submit" },
        { "expect": "titles", "titles": ["Call mom"] },
        { "expect": "priority", "title": "Call mom", "priority": "high" },
        { "expect": "dueDate", "title": "Call mom", "dueDate": "2030-01-15" },
        { "expect": "quickAddPreview", "title": null }
      ]
    },
    {
      "name": "sort-by-due-date-and-overdue",
      "steps": [
        { "do": "add", "title": "Yesterday low", "priority": "low", "dueDate": "2000-01-02" },
        { "do": "add", "title": "Far future high", "priority": "high", "dueDate": "2999-12-31" },
        { "do": "add", "title": "Undated medium" },
        { "expect": "titles", "titles": ["Far future high", "Undated medium", "Yesterday low"] },
        { "expect": "overdue", "title": "Yesterday low", "value": true },
        { "expect": "overdue", "title": "Far future high", "value": false },
        { "do": "sort", "sort": "due" },
        { "expect": "titles", "titles": ["Yesterday low", "Far future high", "Undated medium"] },
        { "do": "toggle", "title": "Yesterday low" },
        { "expect": "overdue", "title": "Yesterday low", "value": false }
      ]
    },
    {
      "name": "bulk-select",
      "steps": [
        { "do": "add", "title": "Buy milk" },
        { "do": "add", "title": "Call mom" },
        { "do": "add", "title": "Walk the dog" },
        { "do": "selectMode" },
        { "expect": "selected", "text": "0 selected" },
        { "do": "select", "title": "Buy milk" },
        { "do": "select", "title": "Call mom" },
        { "expect": "selected", "text": "2 selected" },
        { "do": "bulkToggle" },
        { "expect": "completed", "title": "Buy milk", "value": true },
        { "expect": "completed", "title": "Call mom", "value": true },
        { "expect": "completed", "title": "Walk the dog", "value": false },
        { "expect": "undo", "label": "Completed 2 todos" },
        { "expect": "clearCompleted", "text": "Clear completed (2)" },
        { "do": "selectMode" },
        { "do": "selectAll" },
        { "expect": "selected", "text": "3 selected" },
        { "do": "bulkDelete", "confirm": false },
        { "expect": "selected", "text": "3 selected" },
        { "do": "bulkDelete", "confirm": true },
        { "expect": "empty" },
        { "expect": "undo", "label": "Deleted 3 todos" },
        { "do": "undo" },
        { "expect": "titles", "titles": ["Walk the dog", "Buy milk", "Call mom"] }
      ]
    },
    {
      "name": "search",
      "platforms": ["web"],
      "steps": [
        { "do": "add", "title": "Buy milk" },
        { "do": "add", "title": "Call mom" },
        { "do": "search", "query": "milk" },
        { "expect": "titles", "titles": ["Buy milk"] }
      ]
    },
    {
      "name": "recurring-reschedules",
      "steps": [
        { "do": "add", "title": "Water plants", "dueDate": "2026-01-31", "recurrence": "monthly" },
        { "expect": "recurrence", "title": "Water plants", "text": "↻ Monthly" },
        { "do": "toggle", "title": "Water plants" },
        { "expect": "titles", "titles": ["Water plants", "Water plants"] },
        { "expect": "dueDate", "title": "Water plants", "dueDate": "2026-02-28" },
        { "expect": "remaining", "text": "1 task remaining" },
        { "expect": "undo", "label": "Completed todo" },
        { "do": "relaunch" },
        { "expect": "titles", "titles": ["Water plants", "Water plants"] },
        { "expect": "dueDate", "title": "Water plants", "dueDate": "2026-02-28" }
      ]
    },
    {
      "name": "stats",
      "steps": [
        { "do": "add", "title": "Stretch" },
        { "do": "toggle", "title": "Stretch" },
        { "do": "openStats" },
        { "expect": "stats", "total": "1", "current": "1d", "longest": "1d" },
        { "do": "relaunch" },
        { "do": "openStats" },
        { "expect": "stats", "total": "1", "current": "1d", "longest": "1d" }
      ]
    }
  ]
}
