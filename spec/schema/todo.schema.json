{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://todo-tracker/spec/schema/todo.schema.json",
  "title": "Todo",
  "description": "A single todo as stored and exchanged by every client.",
  "type": "object",
  "required": ["id", "title", "completed", "priority", "createdAt", "updatedAt"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^\\S(.*\\S)?$" },
    "notes": { "type": "string", "minLength": 1 },
    "completed": { "type": "boolean" },
    "priority": { "$ref": "#/$defs/priority" },
    "dueDate": { "$ref": "#/$defs/date" },
    "createdAt": { "$ref": "#/$defs/timestamp" },
    "updatedAt": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "priority": { "enum": ["low", "medium", "high"] },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "Calendar date, YYYY-MM-DD, no time zone." },
    "timestamp": { "type": "string", "format": "date-time", "description": "UTC ISO-8601 with milliseconds, e.g. 2026-01-01T09:00:00.000Z." },
    "draft": {
      "type": "object",
      "required": ["title"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "notes": { "type": "string" },
        "priority": { "$ref": "#/$defs/priority" },
        "dueDate": { "$ref": "#/$defs/date" }
      }
    }
  }
}
