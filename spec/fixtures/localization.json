        "voice.undo": "Undo",
        "undo.action": "Undo"
      }
    },
    {
      "name": "resolveLocale: exact tag",
      "op": "resolveLocale",
      "given": {
        "preferred": [
          "en"
        ]
      },
      "then": "en"
    },
    {
      "name": "resolveLocale: region falls back to its language",
      "op": "resolveLocale",
      "given": {
        "preferred": [
          "en-US"
        ]
      },
      "then": "en"
    },
    {
      "name": "resolveLocale: first supported tag wins",
      "op": "resolveLocale",
      "given": {
        "preferred": [
          "fr-CA",
          "en-GB"
        ]
      },
      "then": "en"
    },
    {
      "name": "resolveLocale: underscore separator",
      "op": "resolveLocale",
      "given": {
        "preferred": [
          "EN_us"
        ]
      },
      "then": "en"
    },
    {
      "name": "resolveLocale: unsupported falls back to English",
      "op": "resolveLocale",
      "given": {
        "preferred": [
          "fr",
          "de-DE"
        ]
      },
      "then": "en"
    },
    {
      "name": "resolveLocale: empty list falls back to English",
      "op": "resolveLocale",
      "given": {
        "preferred": []
      },
      "then": "en"
    },
    {
      "name": "resolveLocale: blank tags are skipped",
      "op": "resolveLocale",
      "given": {
        "preferred": [
          "",
          "en"
        ]
      },
      "then": "en"
    },
    {
      "name": "resolveLocale: exact match beats language match",
      "op": "resolveLocale",
      "given": {
        "preferred": [
          "pt-BR"
        ],
        "supported": [
          "en",
          "pt",
          "pt-BR"
        ]
      },
      "then": "pt-BR"
    },
    {
      "name": "resolveLocale: language match against a regional catalog",
      "op": "resolveLocale",
      "given": {
        "preferred": [
          "pt-PT"
        ],
        "supported": [
          "en",
          "pt-BR"
        ]
      },
      "then": "pt-BR"
    },
    {
      "name": "resolveLocale: matching is case-insensitive",
      "op": "resolveLocale",
      "given": {
        "preferred": [
          "DE"
        ],
        "supported": [
          "en",
          "de"
        ]
      },
      "then": "de"
    },
    {
      "name": "formatMessage: plain text",
      "op": "formatMessage",
      "given": {
        "locale": "en",
        "message": "Add",
        "params": {}
      },
      "then": "Add"
    },
    {
      "name": "formatMessage: named parameter",
      "op": "formatMessage",
      "given": {
        "locale": "en",
        "message": "Delete {title}",
        "params": {
          "title": "Buy milk"
        }
      },
      "then": "Delete Buy milk"
    },
    {
      "name": "formatMessage: missing parameter stays literal",
      "op": "formatMessage",
      "given": {
        "locale": "en",
        "message": "Delete {title}",
        "params": {}
      },
      "then": "Delete {title}"
    },
    {
      "name": "formatMessage: number parameter",
      "op": "formatMessage",
      "given": {
        "locale": "en",
        "message": "Page {n}",
        "params": {
          "n": 3
        }
      },
      "then": "Page 3"
    },
    {
      "name": "formatMessage: plural one",
      "op": "formatMessage",
      "given": {
        "locale": "en",
        "message": "{count, plural, one {# task} other {# tasks}} remaining",
        "params": {
          "count": 1
        }
      },
      "then": "1 task remaining"
    },
    {
      "name": "formatMessage: plural other",
      "op": "formatMessage",
      "given": {
        "locale": "en",
        "message": "{count, plural, one {# task} other {# tasks}} remaining",
        "params": {
          "count": 2
        }
      },
      "then": "2 tasks remaining"
    },
    {
      "name": "formatMessage: plural zero is other in English",
      "op": "formatMessage",
      "given": {
        "locale": "en",
        "message": "{count, plural, one {# task} other {# tasks}} remaining",
        "params": {
          "count": 0
        }
      },
      "then": "0 tasks remaining"
    },
    {
      "name": "formatMessage: # uses grouping separators",
      "op": "formatMessage",
      "given": {
        "locale": "en",
        "message": "{count, plural, one {# task} other {# tasks}}",
        "params": {
          "count": 1234567
        }
      },
      "then": "1,234,567 tasks"
    },
    {
      "name": "formatMessage: exact match beats category",
      "op": "formatMessage",
      "given": {
        "locale": "en",
        "message": "{count, plural, =0 {Nothing left} one {# left} other {# left}}",
        "params": {
          "count": 0
        }
      },
      "then": "Nothing left"
    },
    {
      "name": "formatMessage: missing count is 0",
      "op": "formatMessage",
      "given": {
        "locale": "en",
        "message": "{count, plural, one {# todo} other {# todos}}",
        "params": {}
      },
      "then": "0 todos"
    },
    {
      "name": "formatMessage: string count",
      "op": "formatMessage",
      "given": {
        "locale": "en",
        "message": "{count, plural, one {# todo} other {# todos}}",
        "params": {
          "count": "1"
        }
      },
      "then": "1 todo"
    },
    {
      "name": "formatMessage: missing branch falls back to other",
      "op": "formatMessage",
      "given": {
        "locale": "en",
        "message": "{count, plural, =5 {five} other {#}}",
        "params": {
          "count": 1
        }
      },
      "then": "1"
    },
    {
      "name": "formatMessage: parameters inside a branch",
      "op": "formatMessage",
      "given": {
        "locale": "en",
        "message": "Added {count, plural, one {{first}} other {# todos}}",
        "params": {
          "count": 1,
          "first": "Buy milk"
        }
      },
      "then": "Added Buy milk"
    },
    {
      "name": "formatMessage: two plurals",
      "op": "formatMessage",
      "given": {
        "locale": "en",
        "message": "{a, plural, one {# cat} other {# cats}} and {b, plural, one {# dog} other {# dogs}}",
        "params": {
          "a": 1,
          "b": 3
        }
      },
      "then": "1 cat and 3 dogs"
    },
    {
      "name": "translate: list.remaining {\"count\":0}",
      "op": "translate",
      "given": {
        "locale": "en",
        "key": "list.remaining",
        "params": {
          "count": 0
        }
      },
      "then": "0 tasks remaining"
    },
    {
      "name": "translate: list.remaining {\"count\":1}",
      "op": "translate",
      "given": {
        "locale": "en",
        "key": "list.remaining",
        "params": {
          "count": 1
        }
      },
      "then": "1 task remaining"
    },
    {
      "name": "translate: list.remaining {\"count\":2}",
      "op": "translate",
      "given": {
        "locale": "en",
        "key": "list.remaining",
        "params": {
          "count": 2
        }
      },
      "then": "2 tasks remaining"
    },
    {
      "name": "translate: list.emptyFiltered {\"filter\":\"completed\"}",
      "op": "translate",
      "given": {
        "locale": "en",
        "key": "list.emptyFiltered",
        "params": {
          "filter": "completed"
        }
      },
      "then": "No completed todos."
    },
    {
      "name": "translate: item.delete {\"title\":\"Buy milk\"}",
      "op": "translate",
      "given": {
        "locale": "en",
        "key": "item.delete",
        "params": {
          "title": "Buy milk"
        }
      },
      "then": "Delete \"Buy milk\""
    },
    {
      "name": "translate: voice.added {\"count\":1,\"first\":\"Buy milk\"}",
      "op": "translate",
      "given": {
        "locale": "en",
        "key": "voice.added",
        "params": {
          "count": 1,
          "first": "Buy milk"
        }
      },
      "then": "Added Buy milk"
    },
    {
      "name": "translate: voice.added {\"count\":3,\"first\":\"Buy milk\"}",
      "op": "translate",
      "given": {
        "locale": "en",
        "key": "voice.added",
        "params": {
          "count": 3,
          "first": "Buy milk"
        }
      },
      "then": "Added 3 todos"
    },
    {
      "name": "translate: priority.high {}",
      "op": "translate",
      "given": {
        "locale": "en",
        "key": "priority.high",
        "params": {}
      },
      "then": "High"
    },
    {
      "name": "translate: unsupported locale formats as English",
      "op": "translate",
      "given": {
        "locale": "fr",
        "key": "list.remaining",
        "params": {
          "count": 1
        }
      },
      "then": "1 task remaining"
    },
    {
      "name": "translate: unknown key renders as the key",
      "op": "translate",
      "given": {
        "locale": "en",
        "key": "nope.missing",
        "params": {}
      },
      "then": "nope.missing"
