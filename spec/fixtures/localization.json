        "filter.completed": "Completed",
        "search.placeholder": "Search todos…",
        "search.label": "Search todos",
        "search.clear": "Clear search",
        "list.label": "Todos",
        "list.loading": "Loading…",
        "list.empty": "No todos yet. Add your first one above.",
