<resources>
    <color name="widget_card">#FFFFFFFF</color>
    <color name="widget_border">#1A000000</color>
    <color name="widget_foreground">#FF171717</color>
    <color name="widget_muted">#99171717</color>
    <color name="widget_danger">#FFDC2626</color>

    <string name="today_widget_title">Today</string>
    <string name="today_widget_description">Open todos due today, overdue first.</string>

    <style name="WidgetItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/widget_foreground</item>
        <item name="android:textSize">14sp</item>
        <item name="android:visibility">gone</item>
    </style>
</resources>
