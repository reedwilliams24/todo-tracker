{
  "name": "todo-tracker",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "spec:record": "pnpm --filter @todo/spec record",
    "spec:generate": "pnpm --filter @todo/spec generate",
    "spec:check": "pnpm --filter @todo/spec record --check && pnpm --filter @todo/spec generate --check",
    "spec:parity": "pnpm --filter @todo/spec parity"
  }
}
